# Copy to .env.local. For local development against the emulators, only
# VITE_USE_EMULATORS=true is needed (project id defaults to demo-gear).
VITE_USE_EMULATORS=true

# Firebase web app config for a real project (Project settings → Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
