rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }

    // An active, unexpired user profile. Profiles are created by the
    // activateAccount function from an invite or an auto-join domain.
    function isActive() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && me().active == true
        && (me().expiresAt == null || me().expiresAt > request.time);
    }
    function hasRole(roles) { return isActive() && me().role in roles; }
    function isAdmin() { return hasRole(['admin']); }
    function isManager() { return hasRole(['admin', 'manager']); }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(keys) { return changed().hasOnly(keys); }

    // Every client write records who made it and when.
    function stampedCreate() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && stampedUpdate();
    }
    function stampedUpdate() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function optString(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function optNumber(d, k) { return !(k in d) || d[k] == null || d[k] is number; }
    function optDate(d, k) { return !(k in d) || d[k] == null || (d[k] is string && d[k].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }

    // --------------------------------------------------------- users & access

    match /users/{uid} {
      // Everyone may read their own profile, so the app can tell a pending
      // activation from a deactivated account.
      allow read: if isActive() || (signedIn() && request.auth.uid == uid);
      // Created by the activateAccount function only.
      allow create: if false;
      allow update: if (isAdmin() && stampedUpdate()
                         && request.resource.data.role in ['admin', 'manager', 'staff', 'technician']
                         // admins cannot lock themselves out
                         && (uid != request.auth.uid
                             || (request.resource.data.role == 'admin' && request.resource.data.active == true)))
                    || (uid == request.auth.uid && isActive() && stampedUpdate()
                        && onlyChanged(['displayName', 'phone', 'slackUserId', 'homeProgramAreaId',
                                        'notificationPrefs', 'updatedAt', 'updatedBy'])
        && (!('notificationPrefs' in request.resource.data) || request.resource.data.notificationPrefs is map));
      allow delete: if false;
    }

    match /invites/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && stampedUpdate()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.role in ['admin', 'manager', 'staff', 'technician'];
    }

    match /settings/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /auditLog/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // --------------------------------------------------------- reference data

    function validRef(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.active is bool
        && optString(d, 'description', 2000);
    }

    match /programAreas/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate() && validRef(request.resource.data);
      allow update: if isManager() && stampedUpdate() && validRef(request.resource.data);
      allow delete: if isAdmin();
    }
    match /locations/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate() && validRef(request.resource.data);
      allow update: if isManager() && stampedUpdate() && validRef(request.resource.data);
      allow delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate() && validRef(request.resource.data);
      allow update: if isManager() && stampedUpdate() && validRef(request.resource.data);
      allow delete: if isAdmin();
    }
    match /manufacturers/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate() && validRef(request.resource.data);
      allow update: if isManager() && stampedUpdate() && validRef(request.resource.data);
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------- products

    function validProduct(d) {
      return d.model is string && d.model.size() > 0 && d.model.size() <= 160
        && d.active is bool
        && optString(d, 'variant', 160)
        && optNumber(d, 'lifetimeYears')
        && optNumber(d, 'replacementCost')
        && optList(d, 'links', 50)
        && optList(d, 'inspectionSchedules', 20);
    }

    match /products/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate() && validProduct(request.resource.data);
      allow update: if isManager() && stampedUpdate() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------- gear

    function qrPath(code) { return /databases/$(database)/documents/qrCodes/$(code); }
    function gearPath(id) { return /databases/$(database)/documents/gear/$(id); }

    function validGear(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.status in ['active', 'has_issues', 'quarantined', 'retired']
        && d.qrCode is string && d.qrCode.size() > 0
        && optString(d, 'serialNumber', 120)
        && optList(d, 'tags', 50)
        && optList(d, 'links', 50)
        && optNumber(d, 'purchaseValue')
        && optDate(d, 'mfgDate') && optDate(d, 'purchaseDate') && optDate(d, 'firstUseDate')
        && optDate(d, 'customEol') && optDate(d, 'retiredDate');
    }

    // The QR code must be claimed in /qrCodes in the same batch.
    function ownsQr(id, d) {
      return existsAfter(qrPath(d.qrCode)) && getAfter(qrPath(d.qrCode)).data.gearId == id;
    }

    // A status change carries a reason and a fresh timestamp, so the history
    // trigger never reuses a stale reason.
    // Gear returns to Active by closing its work orders (a Cloud Function);
    // only admins can set it directly, e.g. to correct imported data.
    function validStatusChange() {
      return request.resource.data.status == resource.data.status
        || (request.resource.data.statusReason is string
            && request.resource.data.statusReason.size() > 0
            && request.resource.data.statusChangedAt == request.time
            && (request.resource.data.status != 'active' || isAdmin()));
    }

    match /gear/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate()
        && validGear(request.resource.data) && ownsQr(id, request.resource.data);
      allow update: if isManager() && stampedUpdate()
        && validGear(request.resource.data) && ownsQr(id, request.resource.data)
        && validStatusChange()
        // fields maintained by Cloud Functions
        && !changed().hasAny(['openInspectionWorkOrderId', 'stats', 'inspectionState']);
      allow delete: if isAdmin();

      match /statusHistory/{entry} {
        allow read: if isActive();
        allow write: if false;
      }
    }

    match /qrCodes/{code} {
      allow read: if isActive();
      // Claim a free code for gear that will hold it after this batch.
      allow create: if isManager()
        && code == code.upper()
        && getAfter(gearPath(request.resource.data.gearId)).data.qrCode == code;
      // Release a code the gear no longer uses (re-tagging or deletion).
      allow delete: if isManager()
        && (!existsAfter(gearPath(resource.data.gearId))
            || getAfter(gearPath(resource.data.gearId)).data.qrCode != code);
      allow update: if false;
    }

    // ------------------------------------------------------------ inspections

    function validForm(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.active is bool
        && d.version is int && d.version > 0
        && d.items is list && d.items.size() <= 150;
    }

    match /inspectionForms/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate() && validForm(request.resource.data)
        && request.resource.data.version == 1;
      // Every save bumps the version that inspections record.
      allow update: if isManager() && stampedUpdate() && validForm(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if isAdmin();
    }

    match /inspectionAssignments/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate()
        && request.resource.data.scope in ['product', 'category', 'location', 'programArea']
        && request.resource.data.refId is string
        && request.resource.data.userIds is list && request.resource.data.userIds.size() <= 50;
      allow update: if isManager() && stampedUpdate()
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.refId == resource.data.refId
        && request.resource.data.userIds is list && request.resource.data.userIds.size() <= 50;
      allow delete: if isManager();
    }

    function validOverride(d) {
      return !('override' in d) || d.override == null
        || (d.override.status in ['active', 'has_issues', 'quarantined']
            && d.override.reason is string && d.override.reason.size() > 0);
    }

    // Any active user can inspect. Results are permanent; the applyInspection
    // function fills in the outcome fields.
    match /inspections/{id} {
      allow read: if isActive();
      allow create: if isActive() && stampedCreate()
        && request.resource.data.inspectorId == request.auth.uid
        && exists(gearPath(request.resource.data.gearId))
        && request.resource.data.formId is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.responses is list
        && request.resource.data.responses.size() <= 150
        && validOverride(request.resource.data)
        && !request.resource.data.keys().hasAny(['processedAt', 'statusApplied', 'statusBefore', 'workOrderId']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ work orders

    function validWorkOrder(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.severity in ['note', 'has_issues', 'quarantined']
        && d.status in ['open', 'in_progress', 'waiting_parts', 'done', 'cancelled']
        && d.priority in ['low', 'normal', 'high', 'urgent']
        && (d.assigneeId == null || d.assigneeId is string)
        && optDate(d, 'dueDate')
        && optString(d, 'description', 10000)
        && optString(d, 'resolution', 5000)
        && optNumber(d, 'cost') && optNumber(d, 'laborHours');
    }

    // Closing as done needs a resolution; only managers cancel.
    function validClose(d) {
      return (d.status != 'done' || (d.resolution is string && d.resolution.size() > 0))
        && (d.status != 'cancelled' || resource.data.status == 'cancelled' || isManager());
    }

    match /workOrders/{id} {
      allow read: if isActive();
      // Anyone can report an issue; managers can open one directly. Numbers
      // and inspection work orders come from Cloud Functions.
      allow create: if isActive() && stampedCreate()
        && validWorkOrder(request.resource.data)
        && request.resource.data.status == 'open'
        && (request.resource.data.source == 'issue'
            || (request.resource.data.source == 'manual' && isManager()))
        && exists(gearPath(request.resource.data.gearId))
        && !request.resource.data.keys().hasAny(['number', 'inspectionIds', 'closedAt', 'closedBy', 'gearStatusAfterClose']);
      // Managers edit anything; the assignee works the order through to done.
      allow update: if isActive() && stampedUpdate()
        && validWorkOrder(request.resource.data)
        && validClose(request.resource.data)
        && !changed().hasAny(['number', 'gearId', 'source', 'inspectionIds', 'createdAt', 'createdBy',
                              'closedAt', 'closedBy', 'gearStatusAfterClose', 'autoAssign'])
        && (isManager()
            || (resource.data.assigneeId == request.auth.uid
                && onlyChanged(['status', 'resolution', 'cost', 'laborHours', 'updatedAt', 'updatedBy'])));
      allow delete: if isAdmin();

      match /log/{entry} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.type == 'comment'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }

    match /workOrderRules/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /counters/{id} {
      allow read, write: if false;
    }

    // ---------------------------------------------------- lists, kits, usage

    function validList(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.active is bool
        && d.lines is list && d.lines.size() <= 100;
    }

    match /lists/{id} {
      allow read: if isActive();
      allow create: if isManager() && stampedCreate() && validList(request.resource.data);
      allow update: if isManager() && stampedUpdate() && validList(request.resource.data);
      allow delete: if isManager();
    }

    function validKit(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.ownerId is string
        && d.status in ['planned', 'checked_out', 'returned']
        && d.gearIds is list && d.gearIds.size() <= 300
        && optDate(d, 'startDate') && optDate(d, 'endDate')
        && (d.startDate == null || d.endDate == null || d.startDate <= d.endDate);
    }

    // Everyone sees every kit. People manage their own; admins manage anyone's.
    match /kits/{id} {
      allow read: if isActive();
      allow create: if isActive() && stampedCreate() && validKit(request.resource.data)
        && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isActive() && stampedUpdate() && validKit(request.resource.data)
        && (resource.data.ownerId == request.auth.uid || isAdmin())
        && (request.resource.data.ownerId == resource.data.ownerId || isAdmin());
      allow delete: if isActive() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /checkouts/{id} {
      allow read: if isActive();
      allow create: if isActive() && stampedCreate()
        && (request.resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.status == 'out'
        && exists(gearPath(request.resource.data.gearId))
        && request.resource.data.startDate is string;
      allow update: if isActive() && stampedUpdate()
        && (resource.data.userId == request.auth.uid || isManager())
        && request.resource.data.status in ['out', 'returned']
        && !changed().hasAny(['gearId', 'userId', 'createdAt', 'createdBy']);
      allow delete: if isAdmin();
    }

    // Days used are permanent once logged; a function adds them to gear.stats.
    match /usageLogs/{id} {
      allow read: if isActive();
      allow create: if isActive() && stampedCreate()
        && (request.resource.data.userId == request.auth.uid || isManager())
        && exists(gearPath(request.resource.data.gearId))
        && request.resource.data.daysUsed is number
        && request.resource.data.daysUsed >= 0 && request.resource.data.daysUsed <= 366
        && optNumber(request.resource.data, 'uses')
        && request.resource.data.startDate is string && request.resource.data.endDate is string
        && !('processedAt' in request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------- notifications

    // Outbox written and delivered by Cloud Functions. People can see their
    // own; admins see everything (for troubleshooting).
    match /notifications/{id} {
      allow read: if isAdmin() || (isActive() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Email/Slack credentials: admins can set them but nobody can read them
    // back from the app — only Cloud Functions use them.
    match /private/{doc} {
      allow read: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ----------------------------------------------------------------- photos

    match /photos/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.uploadedBy == request.auth.uid
        && stampedCreate()
        && request.resource.data.storagePath == 'photos/' + id + '/full.jpg'
        && request.resource.data.thumbPath == 'photos/' + id + '/thumb.jpg';
      allow update: if isActive() && stampedUpdate()
        && ((resource.data.uploadedBy == request.auth.uid && onlyChanged(['uploaded', 'caption', 'updatedAt', 'updatedBy']))
            || (isManager() && onlyChanged(['caption', 'updatedAt', 'updatedBy'])));
      allow delete: if resource.data.uploadedBy == request.auth.uid && isActive() || isManager();
    }
  }
}
